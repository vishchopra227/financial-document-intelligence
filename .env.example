# ==============================================================================
# FinSight Intelligence - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (MySQL)
# Default is configured to connect to local MySQL (service MySQL80).
# If MySQL connection fails, the system gracefully falls back to local SQLite for frictionless local dev.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/finsight_intelligence
# Fallback SQLite path when MySQL is not initialized
SQLITE_DB_PATH=backend/data/finsight.db

# Storage Directories
UPLOAD_DIR=backend/data/uploads
VECTOR_STORE_DIR=backend/data/vector_store
MAX_UPLOAD_SIZE_MB=30

# Vector Store Engine (persistent_numpy | chromadb)
VECTOR_STORE_BACKEND=persistent_numpy

# ------------------------------------------------------------------------------
# Groq API Configuration (Fast, High-Quality LLM Inference)
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY= 
GROQ_MODEL=llama-3.3-70b-versatile


# Primary LLM Provider (groq | mock | gemini | openai)
# If GROQ_API_KEY is provided, LLM_PROVIDER automatically defaults to 'groq'
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Embedding Provider (mock | gemini | openai)
# Default 'mock' generates deterministic financial document embeddings locally without any API key or cost
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=default
EMBEDDING_API_KEY=

# RAG Configuration
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_SIMILARITY_THRESHOLD=0.35
RAG_ENABLE_HYBRID_SEARCH=true
